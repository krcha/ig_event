#!/usr/bin/env bash
# Starts exactly eight independently leased receipt executors for one durable run.
set -Eeuo pipefail
ENV_FILE="${IG_EVENT_CRON_ENV:-/etc/ig_event/cron.env}"
RUN_ID="${1:?usage: ig-event-durable-runner RUN_ID}"
. "$ENV_FILE"
: "${APP_ORIGIN:?missing APP_ORIGIN}" "${CRON_SECRET:?missing CRON_SECRET}"
URL="${APP_ORIGIN%/}/api/cron/durable-ingestion/execute?runId=${RUN_ID}"
worker() {
  while true; do
    body="$(curl --fail --silent --show-error --max-time 300 \
      -H "Authorization: Bearer ${CRON_SECRET}" -X POST "$URL")" || exit 1
    [[ "$body" == *'"claimed":false'* ]] && exit 0
  done
}
for _ in {1..8}; do worker & done
wait
