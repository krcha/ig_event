#!/usr/bin/env bash
# Starts exactly eight independently leased receipt executors for one durable run.
set -Eeuo pipefail
ENV_FILE="${IG_EVENT_CRON_ENV:-/etc/ig_event/cron.env}"
RUN_ID="${1:?usage: ig-event-durable-runner RUN_ID}"
. "$ENV_FILE"
: "${APP_ORIGIN:?missing APP_ORIGIN}" "${CRON_SECRET:?missing CRON_SECRET}"
URL="${APP_ORIGIN%/}/api/cron/durable-ingestion/execute?runId=${RUN_ID}"
worker() {
  while true; do
    # A transport failure means the receipt was either released for retry or
    # its lease will expire.  Exit non-zero so systemd restarts the host runner;
    # never turn it into a false completed profile.
    body="$(curl --fail --silent --show-error --max-time 300 \
      -H "Authorization: Bearer ${CRON_SECRET}" -X POST "$URL")" || exit 1
    if [[ "$body" == *'"claimed":false'* ]]; then
      [[ "$body" == *'"complete":true'* ]] && exit 0
      # A restarted runner can see the prior process's valid leases. Wait for
      # those workers to complete or expire, then reclaim safely.
      sleep 5
    fi
  done
}
pids=()
for _ in {1..8}; do
  worker &
  pids+=("$!")
done

# `wait` without explicit PIDs returns only one status and can hide another
# worker's failed curl. Collect every exit so systemd reliably restarts this
# resumable controller when any leased worker fails.
failed=0
for pid in "${pids[@]}"; do
  if ! wait "$pid"; then
    failed=1
  fi
done
exit "$failed"
